# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5001
MONGODB_URL=mongodb://127.0.0.1:27017/novastore

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API cross-origin (empty = same origin only)
CORS_ORIGINS=

# PayPal: without a secret, payments are accepted unverified outside production
PAYPAL_CLIENT_ID=sb
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Image uploads (local folder, or S3 when S3_BUCKET is set; credentials come from the AWS default chain)
UPLOAD_DIR=uploads
S3_BUCKET=
S3_REGION=us-east-1

# Used by `npm run seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
