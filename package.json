{
  "name": "novastore",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "NovaStore e-commerce API and storefront",
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.js",
    "dev": "node --watch-path=backend --env-file-if-exists=.env backend/server.js",
    "seed": "node --env-file-if-exists=.env backend/scripts/seed.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 'backend/**/*.test.js'",
    "lint": "eslint backend",
    "build": "cd frontend && npm install && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "multer": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
